{
  "name": "desktop-commander-manager",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "dev": "tsx apps/server/src/cli.ts",
    "build": "tsc -p tsconfig.json && npm run build -w apps/dashboard",
    "autostart:install": "tsx apps/server/src/autostart-cli.ts install",
    "autostart:uninstall": "tsx apps/server/src/autostart-cli.ts uninstall",
    "autostart:status": "tsx apps/server/src/autostart-cli.ts status",
    "tunnel:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-tunnel.ps1",
    "smoke:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-windows.ps1",
    "benchmark:node": "tsx tests/benchmarks/node-baseline.ts",
    "benchmark:m1": "tsx tests/benchmarks/m1-platform-benchmark.ts",
    "benchmark:m4": "tsx tests/benchmarks/m4-state-router-benchmark.ts",
    "benchmark:m5": "tsx tests/benchmarks/m5-management-api-benchmark.ts",
    "test:contracts": "vitest run tests/contracts",
    "test:recovery": "vitest run tests/recovery",
    "build:rust": "cargo build --workspace --release",
    "test:rust": "cargo test --workspace",
    "lint:rust": "cargo fmt --check && cargo clippy --workspace --all-targets --all-features -- -D warnings"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@wonderwhy-er/desktop-commander": "0.2.52"
  }
}
